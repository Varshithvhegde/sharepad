NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The deployed origin. Canonicals, the sitemap, llms.txt and share links all
# derive from this, so it must be the real one in production.
# Use http://localhost:3000 in .env.local while developing.
NEXT_PUBLIC_SITE_URL=https://sharepad.in

# Optional. Without a token, analytics is skipped entirely and the app runs as normal.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional. Image upload stays switched off until all five are set, so a
# checkout without them behaves exactly as it did before.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sharepad
# Where readers load images from: the bucket's r2.dev public URL, or a custom
# domain such as https://img.sharepad.in.
R2_PUBLIC_BASE_URL=

# Any long random string. The sweep workflow must send the same one.
IMAGE_SWEEP_SECRET=

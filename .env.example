NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The deployed origin. Canonicals, the sitemap, llms.txt and share links all
# derive from this, so it must be the real one in production.
# Use http://localhost:3000 in .env.local while developing.
NEXT_PUBLIC_SITE_URL=https://sharepad.in

# Optional. Without a token, analytics is skipped entirely and the app runs as normal.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
